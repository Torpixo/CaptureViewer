<Window x:Class="CaptureViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture Viewer" Width="1280" Height="720" Background="Black"
        KeyDown="Window_KeyDown" MouseMove="Window_MouseMove" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="28"/></Style>
        <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,4"/><Setter Property="MinHeight" Value="28"/></Style>
        <Style x:Key="Cap" TargetType="TextBlock"><Setter Property="Foreground" Value="#8A94A6"/><Setter Property="FontSize" Value="10"/><Setter Property="Margin" Value="6,0,0,0"/></Style>
    </Window.Resources>
    <Grid>
        <Image x:Name="Screen" Stretch="Uniform" MouseLeftButtonDown="Screen_MouseDown"/>
        <TextBlock x:Name="Hint" Text="Choose your devices below and press Start" Foreground="#8A94A6" FontSize="18"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <TextBlock x:Name="Stats" Foreground="White" Background="#A0000000" Padding="8,4" FontFamily="Consolas" FontSize="12"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" IsHitTestVisible="False"/>
        <TextBlock x:Name="Toast" Foreground="White" Background="#F0C83237" Padding="10,6" TextWrapping="Wrap" MaxWidth="420"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Visibility="Collapsed"/>
        <Border x:Name="Bar" VerticalAlignment="Bottom" Background="#D9101318" Padding="8">
            <WrapPanel HorizontalAlignment="Center">
                <StackPanel><TextBlock Style="{StaticResource Cap}" Text="VIDEO DEVICE"/><ComboBox x:Name="CmbVideo" Width="210" SelectionChanged="Video_Changed"/></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource Cap}" Text="RESOLUTION"/><ComboBox x:Name="CmbRes" Width="105" SelectionChanged="Video_Changed"/></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource Cap}" Text="FPS"/><ComboBox x:Name="CmbFps" Width="65" SelectionChanged="Video_Changed"/></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource Cap}" Text="FORMAT"/><ComboBox x:Name="CmbFmt" Width="75" SelectionChanged="Video_Changed"/></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource Cap}" Text="AUDIO INPUT"/><ComboBox x:Name="CmbIn" Width="250" SelectionChanged="Audio_Changed"/></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource Cap}" Text="AUDIO OUTPUT (SPEAKERS)"/><ComboBox x:Name="CmbOut" Width="250" SelectionChanged="Audio_Changed"/></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource Cap}" Text="VOLUME"/><Slider x:Name="Vol" Width="90" Minimum="0" Maximum="1" Value="1" Margin="4,8,4,0" ValueChanged="Vol_Changed"/></StackPanel>
                <Button x:Name="BtnStart" Content="Start" Click="Start_Click" VerticalAlignment="Bottom" FontWeight="SemiBold"/>
                <Button x:Name="BtnMute" Content="Mute" Click="Mute_Click" VerticalAlignment="Bottom"/>
                <Button Content="Rescan" Click="Rescan_Click" VerticalAlignment="Bottom" ToolTip="Detect newly plugged-in video and audio devices"/>
                <Button Content="Snapshot" Click="Snap_Click" VerticalAlignment="Bottom"/>
                <Button Content="Fullscreen" Click="Full_Click" VerticalAlignment="Bottom"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
